EH_APP_NAME=EnergeticHack

# LLM provider: ollama | openai | anthropic | none
EH_LLM_PROVIDER=ollama
EH_LLM_MODEL=llama3.1
EH_OLLAMA_BASE_URL=http://localhost:11434

# For EH_LLM_PROVIDER=openai (OpenAI, OpenRouter, any compatible API):
EH_OPENAI_BASE_URL=https://api.openai.com/v1
EH_OPENAI_API_KEY=

# For EH_LLM_PROVIDER=anthropic:
EH_ANTHROPIC_API_KEY=
EH_ANTHROPIC_MODEL=claude-sonnet-5-5

# Disable changing LLM settings from the web UI (for public deployments)
EH_SETTINGS_LOCKED=false

EH_HOST=0.0.0.0
EH_PORT=8899
