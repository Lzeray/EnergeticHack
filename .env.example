# Copy to .env and adjust. All variables are optional — sane defaults are
# baked into app/config.py. Prefix is EH_ (see pydantic-settings env_prefix).

EH_APP_NAME=EnergeticHack

# LLM provider: ollama | openai | anthropic | none
# Can also be changed at runtime from the Settings page (stored in DB and
# takes precedence over these env vars).
EH_LLM_PROVIDER=ollama
EH_LLM_MODEL=llama3.1
EH_OLLAMA_BASE_URL=http://localhost:11434

# For EH_LLM_PROVIDER=openai (also used for OpenRouter and any other
# OpenAI-compatible endpoint):
EH_OPENAI_BASE_URL=https://api.openai.com/v1
EH_OPENAI_API_KEY=

# For EH_LLM_PROVIDER=anthropic:
EH_ANTHROPIC_API_KEY=
EH_ANTHROPIC_MODEL=claude-sonnet-5-5

EH_HOST=0.0.0.0
EH_PORT=8899
